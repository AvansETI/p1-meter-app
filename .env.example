# Copy to .env and fill in locally. Never commit .env.

# API server (defaults: development, 127.0.0.1, 3000, info, ../web/dist)
NODE_ENV=
API_HOST=
API_PORT=
LOG_LEVEL=
WEB_DIST=

# InfluxDB (read-only token, backend only; used from the data feature onwards)
INFLUX_URL=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_TOKEN=

# Day-ahead prices for costs (separate bucket, read/write token; ENTSO-E API token)
PRICES_INFLUX_BUCKET=
PRICES_INFLUX_TOKEN=
ENTSOE_TOKEN=
