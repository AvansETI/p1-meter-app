# MNEXT Energiemeter API + web app (docs/design/2026-11-09-deployment.md §4.3)
[Unit]
Description=MNEXT Energiemeter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=p1meter
Group=p1meter
EnvironmentFile=/etc/p1-meter-app/env
WorkingDirectory=/opt/p1-meter-app/current/api
ExecStart=/opt/node/current/bin/node /opt/p1-meter-app/current/api/dist/index.mjs
Restart=on-failure
# App database and backups (/var/lib/p1-meter-app, owned by p1meter; writable despite
# ProtectSystem=strict). systemd passes the path as STATE_DIRECTORY.
StateDirectory=p1-meter-app
StateDirectoryMode=0750
RestartSec=5

# Hardening: the app only needs to read its files and talk over the network.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_NETLINK: Node reads the network interfaces (os.networkInterfaces) when listening on 0.0.0.0.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=512M

[Install]
WantedBy=multi-user.target
