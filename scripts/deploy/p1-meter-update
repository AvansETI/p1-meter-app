#!/usr/bin/env bash
# Pull-based updater for MNEXT Energiemeter on the production LXC.
# See docs/design/2026-11-09-deployment.md §4.4 and docs/operations.md.
#
#   p1-meter-update                 install the newest build of main if it is new
#   p1-meter-update --force         reinstall even if it is the running version
#   p1-meter-update --rollback      switch back to the previous release
#   p1-meter-update --dry-run [--manifest FILE --package FILE]
#                                   verify a package without installing (used in CI)
set -euo pipefail

REPO="${P1_REPO:-AvansETI/p1-meter-app}"
RELEASE_TAG="${P1_RELEASE_TAG:-main-latest}"
APP_DIR="${P1_APP_DIR:-/opt/p1-meter-app}"
NODE_DIR="${P1_NODE_DIR:-/opt/node}"
ENV_FILE="${P1_ENV_FILE:-/etc/p1-meter-app/env}"
SERVICE="p1-meter-app"
UNIT_DIR="${P1_UNIT_DIR:-/etc/systemd/system}"
UPDATER="${P1_UPDATER:-/usr/local/sbin/p1-meter-update}"
HEALTH_URL="${P1_HEALTH_URL:-http://127.0.0.1:8080/api/v1/health}"
HEALTH_TIMEOUT_SEC=30
KEEP_RELEASES=3

log() { echo "p1-meter-update: $*"; }
die() {
  log "ERROR: $*"
  exit 1
}

mode=update
dry_run=false
force=false
local_manifest=""
local_package=""
while [ $# -gt 0 ]; do
  case "$1" in
    --rollback) mode=rollback ;;
    --dry-run) dry_run=true ;;
    --force) force=true ;;
    --manifest) local_manifest="$2"; shift ;;
    --package) local_package="$2"; shift ;;
    -h | --help) sed -n '2,11p' "$0"; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done

workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

if [ "$dry_run" = false ]; then
  [ "$(id -u)" -eq 0 ] || die "run as root (sudo)"
  exec 9>/run/p1-meter-update.lock
  flock -n 9 || { log "another update is running"; exit 0; }
fi

current_release() {
  if [ -L "$APP_DIR/current" ]; then readlink -f "$APP_DIR/current"; fi
}

# Points /opt/node/current at the Node version the release was built for (.nvmrc).
use_node_for() {
  local version
  version="$(tr -d '[:space:]' <"$1/.nvmrc")"
  install_node "$version"
  ln -sfn "$NODE_DIR/$version" "$NODE_DIR/current.new"
  mv -Tf "$NODE_DIR/current.new" "$NODE_DIR/current"
}

install_node() {
  local version="$1" arch tarball
  [ -x "$NODE_DIR/$version/bin/node" ] && return 0
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) die "unsupported architecture $(uname -m)" ;;
  esac
  tarball="node-$version-linux-$arch.tar.xz"
  log "installing Node $version"
  curl -fsSL --max-time 300 -o "$workdir/$tarball" "https://nodejs.org/dist/$version/$tarball"
  curl -fsSL --max-time 60 -o "$workdir/SHASUMS256.txt" "https://nodejs.org/dist/$version/SHASUMS256.txt"
  (cd "$workdir" && grep " $tarball\$" SHASUMS256.txt | sha256sum -c --quiet) ||
    die "checksum mismatch for $tarball"
  mkdir -p "$NODE_DIR/$version.tmp"
  tar -xJf "$workdir/$tarball" -C "$NODE_DIR/$version.tmp" --strip-components=1
  mv -T "$NODE_DIR/$version.tmp" "$NODE_DIR/$version"
}

# Atomically points /opt/p1-meter-app/current at a release directory.
switch_to() {
  use_node_for "$1"
  ln -sfn "$1" "$APP_DIR/current.new"
  mv -Tf "$APP_DIR/current.new" "$APP_DIR/current"
}

healthy() {
  local i
  for ((i = 0; i < HEALTH_TIMEOUT_SEC; i++)); do
    curl -fs --max-time 2 -o /dev/null "$HEALTH_URL" && return 0
    sleep 1
  done
  return 1
}

restart_and_check() {
  sync_system_files "$(current_release)/deploy"
  systemctl restart "$SERVICE"
  healthy
}

# Installs the systemd units and the update script shipped in a release when they differ from
# the installed ones (#21). The env file is never touched. A new update script replaces the
# file atomically (new inode), so this running copy is unaffected and it takes effect next run.
sync_system_files() {
  local dir="$1" unit changed=false
  [ -d "$dir" ] || return 0 # packages from before #21 have no deploy/ directory
  for unit in p1-meter-app.service p1-meter-update.service p1-meter-update.timer; do
    [ -f "$dir/$unit" ] || continue
    if ! cmp -s "$dir/$unit" "$UNIT_DIR/$unit"; then
      install -m 644 "$dir/$unit" "$UNIT_DIR/$unit"
      log "updated $unit"
      changed=true
    fi
  done
  [ "$changed" = true ] && systemctl daemon-reload
  if [ -f "$dir/p1-meter-update" ] && ! cmp -s "$dir/p1-meter-update" "$UPDATER"; then
    install -m 755 "$dir/p1-meter-update" "$UPDATER.new"
    mv -f "$UPDATER.new" "$UPDATER"
    log "updated the update script (used from the next run)"
  fi
  return 0
}

check_layout() {
  local dir="$1" path
  for path in .nvmrc api/dist/index.mjs api/node_modules web/dist/index.html \
    deploy/p1-meter-app.service deploy/p1-meter-update; do
    [ -e "$dir/$path" ] || die "package is missing $path"
  done
}

prune_releases() {
  local current
  current="$(current_release)"
  # Newest first; keep KEEP_RELEASES, never remove the running one.
  find "$APP_DIR/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' |
    sort -rn | tail -n +"$((KEEP_RELEASES + 1))" | cut -d' ' -f2- |
    while read -r dir; do
      [ "$dir" = "$current" ] || rm -rf "$dir"
    done
}

asset_url() {
  jq -r --arg name "$1" '.assets[] | select(.name == $name) | .browser_download_url' \
    "$workdir/release.json"
}

rollback() {
  local current previous
  current="$(current_release)"
  previous="$(find "$APP_DIR/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' |
    sort -rn | cut -d' ' -f2- | grep -vx "$current" | head -n 1 || true)"
  [ -n "$previous" ] || die "no previous release to roll back to"
  log "rolling back to $(basename "$previous")"
  switch_to "$previous"
  restart_and_check || die "previous release is not healthy either"
  log "rolled back"
}

update() {
  local manifest="$workdir/manifest.json" package sha file sum url dest previous
  if [ -n "$local_manifest" ]; then
    cp "$local_manifest" "$manifest"
  else
    curl -fsSL --max-time 30 -H 'Accept: application/vnd.github+json' \
      -o "$workdir/release.json" "https://api.github.com/repos/$REPO/releases/tags/$RELEASE_TAG" ||
      die "cannot read release $RELEASE_TAG"
    url="$(asset_url manifest.json)"
    [ -n "$url" ] || { log "no manifest published yet"; exit 0; }
    curl -fsSL --max-time 30 -o "$manifest" "$url"
  fi

  sha="$(jq -r .sha "$manifest")"
  file="$(jq -r .file "$manifest")"
  sum="$(jq -r .sha256 "$manifest")"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "invalid sha in manifest"
  [[ "$file" =~ ^p1-meter-app-[0-9a-f]+\.tar\.gz$ ]] || die "invalid file name in manifest"

  if [ "$dry_run" = false ] && [ "$force" = false ] &&
    [ "$(basename "$(current_release)" | cut -d- -f1)" = "$sha" ]; then
    exit 0 # already running this build; stay quiet for the timer
  fi

  package="$workdir/$file"
  if [ -n "$local_package" ]; then
    cp "$local_package" "$package"
  else
    url="$(asset_url "$file")"
    [ -n "$url" ] || { log "package $file not published yet"; exit 0; }
    curl -fsSL --max-time 300 -o "$package" "$url"
  fi
  echo "$sum  $package" | sha256sum -c --quiet || die "checksum mismatch for $file"

  mkdir -p "$workdir/unpack"
  tar -xzf "$package" -C "$workdir/unpack"
  check_layout "$workdir/unpack/app"

  if [ "$dry_run" = true ]; then
    log "dry run OK: $file ($(jq -r .version "$manifest"), ${sha:0:12})"
    return 0
  fi

  grep -qE '^INFLUX_TOKEN=.+' "$ENV_FILE" ||
    die "INFLUX_TOKEN is empty in $ENV_FILE; fill it in first (see docs/operations.md)"

  dest="$APP_DIR/releases/$sha"
  # A forced reinstall of the running build gets its own directory; never touch the live one.
  [ -e "$dest" ] && dest="$dest-$(date +%s)"
  mv -T "$workdir/unpack/app" "$dest"
  touch "$dest"
  previous="$(current_release)"

  log "deploying $(jq -r .version "$manifest") (${sha:0:12})"
  switch_to "$dest"
  if restart_and_check; then
    log "deployed ${sha:0:12}"
    prune_releases
    return 0
  fi

  if [ -n "$previous" ] && [ -d "$previous" ]; then
    log "health check failed; rolling back to $(basename "$previous")"
    switch_to "$previous"
    restart_and_check || die "rollback is not healthy either"
    die "deploy of ${sha:0:12} failed health check; rolled back"
  fi
  die "deploy of ${sha:0:12} failed health check and there is no previous release"
}

case "$mode" in
  rollback) rollback ;;
  update) update ;;
esac
